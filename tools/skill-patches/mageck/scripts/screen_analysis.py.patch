+def _validate_timeout(timeout):
+    """Require a finite positive execution deadline in seconds."""
+    if isinstance(timeout, bool) or not isinstance(timeout, (int, float)) or not math.isfinite(timeout) or timeout <= 0:
+        raise ValueError("Timeout must be a finite number of seconds > 0")
+
+
+def _stream_text(data):
+    """Decode partial subprocess output captured as bytes or text."""
+    if data is None:
+        return ""
+    if isinstance(data, bytes):
+        return data.decode("utf-8", errors="replace")
+    return data
+
+
+def _check_mageck_version(binary):
+    """Return the MAGeCK version string within VERSION_TIMEOUT seconds."""
+    try:
+        proc = subprocess.run(
+            [binary, "--version"], text=True, capture_output=True, check=True, timeout=VERSION_TIMEOUT,
+        )
+    except subprocess.TimeoutExpired as exc:
+        raise RuntimeError(f"MAGeCK --version timed out after {VERSION_TIMEOUT} seconds") from exc
+    return proc.stdout.strip()
+
