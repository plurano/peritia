{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/plurano/peritia/tools/contracts/method.schema.json",
  "title": "Peritia method contract",
  "description": "A method definition states what one executable method computes, from which inputs, under which model and tool version, where its result holds and how it is checked. tools/method_contract.py adds the checks a schema cannot express.",
  "$defs": {
    "name": {
      "description": "An input name: lower case, digits and underscores.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "id": {
      "description": "A method or skill identifier: lower case, digits and hyphens.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "unit": {
      "description": "The unit symbol in UCUM case-sensitive form, for example A, A.h, s, K, or 1 for a dimensionless ratio.",
      "type": "string",
      "pattern": "^[!-~]{1,32}$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "quantity", "unit", "required"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "quantity": { "description": "The physical quantity, for example electric current.", "$ref": "#/$defs/text" },
        "unit": { "$ref": "#/$defs/unit" },
        "required": { "description": "Whether a run may start without this value.", "type": "boolean" }
      }
    },
    "bound": {
      "description": "Where the method's result holds for one input, in that input's unit. Both ends are inclusive.",
      "type": "object",
      "additionalProperties": false,
      "required": ["input"],
      "anyOf": [{ "required": ["min"] }, { "required": ["max"] }],
      "properties": {
        "input": { "$ref": "#/$defs/name" },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "skill", "task", "inputs", "model", "implementation", "validity_domain", "verifier", "result_class"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "skill": { "description": "The skill directory under skills/ that teaches this method.", "$ref": "#/$defs/id" },
        "task": { "description": "The one concrete task the method supports.", "$ref": "#/$defs/text" },
        "inputs": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/input" } },
        "conventions": {
          "description": "Sign, coordinate and time conventions the inputs and outputs follow.",
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/text" }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "assumptions"],
          "properties": {
            "name": { "$ref": "#/$defs/text" },
            "assumptions": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/text" } }
          }
        },
        "implementation": {
          "description": "The tool that runs the method, at one exact version.",
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "version"],
          "properties": {
            "tool": { "$ref": "#/$defs/text" },
            "version": {
              "description": "An exact release: no range, wildcard or moving name.",
              "type": "string",
              "pattern": "^[0-9][0-9A-Za-z.+_-]{0,63}$"
            }
          }
        },
        "validity_domain": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/bound" } },
        "verifier": {
          "description": "The executable check of a result and the condition it accepts.",
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "acceptance"],
          "properties": {
            "command": {
              "description": "The argument list, first item the program.",
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
            },
            "acceptance": { "$ref": "#/$defs/text" }
          }
        },
        "result_class": {
          "description": "What kind of claim a result of this method is.",
          "enum": [
            "source-assertion",
            "observation",
            "analytical-deduction",
            "numerical-result",
            "empirical-estimate",
            "hypothesis",
            "checked-proof"
          ]
        }
      }
    }
  }
}
