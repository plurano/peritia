# Generated by Praetor from declared project commands; execution is unverified.
-include .config/praetor/engine.mk
# Praetor ships one binary under two names; resolve whichever is installed.
PRAETORCTL ?= $(shell command -v praetorctl 2>/dev/null || command -v standardsctl 2>/dev/null || echo praetorctl)
VENV ?= .venv
BIN = $(VENV)/bin
PYTHON ?= python3
.PHONY: all verify-all compile-context compile-context-verify caveman-sources audit build test tools python-lint

all: build

verify-all: compile-context-verify caveman-sources audit python-lint test

compile-context:
	@$(PRAETORCTL) compile-context

compile-context-verify:
	@$(PRAETORCTL) compile-context --verify

caveman-sources:
	@$(PRAETORCTL) caveman check --configured-sources

audit:
	@$(PRAETORCTL) audit

tools:
	@hash=$$(sha256sum requirements/tools.txt | cut -d ' ' -f 1); \
	if [ "$$(cat $(VENV)/.stamp 2>/dev/null)" != "$$hash" ]; then \
		if [ ! -x $(BIN)/python ]; then $(PYTHON) -m venv $(VENV); fi && \
		$(BIN)/python -m pip install --quiet --disable-pip-version-check --require-hashes -r requirements/tools.txt && \
		printf '%s\n' "$$hash" > $(VENV)/.stamp; \
	fi

# The library's own checks: every skill directory is complete (tools/check_skills.py) and every file
# carries a licence (REUSE). The selftest plants one defect per rule and must see each refused.
# Every tools/test_*.py runs, sorted, one process each; a new test file needs no Makefile edit.
test: tools build
	@$(BIN)/python -B tools/check_skills.py selftest
	@node --test tools/markdownlint/test_normalize.mjs
	@python3 -B tools/install_user_skills.py selftest
	@for file in $(sort $(wildcard tools/test_*.py)); do \
		$(BIN)/python -B "$$file" || { printf 'test failed: %s\n' "$$file" >&2; exit 1; }; \
	done
	@reuse lint

# Ruff with the rule set and baseline in ruff.toml, which mirror Codacy's Ruff patterns, so a
# finding fails here before Codacy reports it on the pull request. Ruff is pinned in
# requirements/tools.txt; --no-cache leaves no .ruff_cache in the tree.
python-lint: tools
	@$(BIN)/ruff check --no-cache --output-format concise .

build: tools
	@$(BIN)/python -B tools/check_skills.py

# BEGIN praetor documentation gate
.PHONY: docs-lint docs-figures
verify-all: docs-lint docs-figures
docs-lint:
	@node tools/markdownlint/verify.mjs
docs-figures:
	@node tools/figures/build.mjs check
	@node tools/figures/build.mjs sources
# END praetor documentation gate
